{
  "name": "advocate-draft",
  "productName": "Advocate Draft",
  "version": "0.2.0",
  "description": "Drafts Indian legal documents from case facts and source documents, in your format, with the AI provider you choose.",
  "main": "src/main.js",
  "author": "Sandeep",
  "homepage": "https://github.com/sandeepnarayankv/AdvocateDraft",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandeepnarayankv/AdvocateDraft.git"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "electron test/smoke-electron.js",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "in.advocatedraft.desktop",
    "productName": "Advocate Draft",
    "copyright": "Copyright © 2026 Sandeep",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/node_modules/@tesseract.js-data/*/4.0.0/**",
      "!**/node_modules/tesseract.js-core/*.wasm.js",
      "!**/node_modules/pdfjs-dist/build/**",
      "!**/node_modules/pdfjs-dist/web/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v1.10.88/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v1.9.426/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v2.0.550/**",
      "!**/node_modules/pdf-parse/test/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@huggingface/transformers/dist/transformers.{js,min.js}",
      "!**/node_modules/@huggingface/transformers/dist/transformers.web*",
      "!**/node_modules/@huggingface/transformers/dist/ort-wasm*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Advocate-Draft-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Advocate Draft",
      "uninstallDisplayName": "Advocate Draft",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "26.17.0",
    "pdf-lib": "1.17.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/canvas": "1.0.11",
    "@tesseract.js-data/ben": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/guj": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/kan": "1.0.0",
    "@tesseract.js-data/mal": "1.0.0",
    "@tesseract.js-data/mar": "1.0.0",
    "@tesseract.js-data/ori": "1.0.0",
    "@tesseract.js-data/pan": "1.0.0",
    "@tesseract.js-data/tam": "1.0.0",
    "@tesseract.js-data/tel": "1.0.0",
    "@tesseract.js-data/urd": "1.0.0",
    "docx": "^9.5.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "allowScripts": {
    "electron@44.10.0": true,
    "tesseract.js": false,
    "electron-winstaller": false,
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
